<% dialog_id = "backup-restore-#{run.id}" %>
<% counts = run.verification['counts'] || {} %>
<button type="button" class="btn btn-xs btn-outline btn-error" onclick="document.getElementById('<%= dialog_id %>').showModal()">
  <%= t('admin.settings.show.backups.restore') %>
</button>

<dialog id="<%= dialog_id %>" class="modal text-left whitespace-normal" data-testid="backup-restore">
  <div class="modal-box max-w-lg">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="<%= t('admin.settings.show.backups.cancel') %>">✕</button>
    </form>

    <h3 class="flex items-center gap-2 text-lg font-bold">
      <%= icon 'rotate-ccw', class: 'size-5' %> <%= t('admin.settings.show.backups.restore_title') %>
    </h3>

    <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
      <dt class="text-base-content/70"><%= t('admin.settings.show.backups.restore_file') %></dt>
      <dd class="font-mono text-xs leading-5 break-all"><%= run.file_name %></dd>
      <dt class="text-base-content/70"><%= t('admin.settings.show.backups.restore_made') %></dt>
      <dd><%= l(run.finished_at || run.started_at, format: :long) %></dd>
      <dt class="text-base-content/70"><%= t('admin.settings.show.backups.restore_contents') %></dt>
      <dd><%= t('admin.settings.show.backups.verification.counts',
                users: number_with_delimiter(counts['users'].to_i), points: number_with_delimiter(counts['points'].to_i)) %></dd>
    </dl>

    <div role="alert" class="alert alert-warning mt-4 items-start text-sm">
      <%= icon 'triangle-alert', class: 'size-5 shrink-0' %>
      <span><%= t('admin.settings.show.backups.restore_warning', time: l(run.finished_at || run.started_at, format: :long)) %></span>
    </div>
    <p class="mt-3 text-sm text-base-content/70"><%= t('admin.settings.show.backups.restore_steps') %></p>

    <%= form_with url: restore_backup_admin_settings_path, method: :post, data: { turbo: false }, class: 'mt-4' do %>
      <%= hidden_field_tag :backup_run_id, run.id, id: nil %>
      <label class="block space-y-1 text-sm" for="<%= dialog_id %>-confirmation">
        <span><%= t('admin.settings.show.backups.restore_confirm_label', word: Backups::Restorer::CONFIRMATION) %></span>
        <input type="text" name="confirmation" id="<%= dialog_id %>-confirmation" required autocomplete="off" spellcheck="false"
               pattern="<%= Backups::Restorer::CONFIRMATION %>" class="input input-bordered input-sm w-full font-mono">
      </label>
      <div class="modal-action">
        <button type="button" class="btn btn-sm btn-ghost" onclick="this.closest('dialog').close()">
          <%= t('admin.settings.show.backups.cancel') %>
        </button>
        <%= submit_tag t('admin.settings.show.backups.restore_submit'), class: 'btn btn-sm btn-error' %>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop"><button><%= t('admin.settings.show.backups.cancel') %></button></form>
</dialog>
